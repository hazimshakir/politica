{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POLITICA person record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "profile_id",
    "scope",
    "note"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "enum": [
        "india",
        "international"
      ]
    },
    "note": {
      "type": "string"
    }
  }
}